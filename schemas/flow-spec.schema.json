{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rcanbaba/ios-agentic-toolkit/schemas/flow-spec.schema.json",
  "title": "Flow Spec",
  "description": "One critical end-to-end flow of the legacy app as a state machine, precise enough to reimplement it and test parity. Describes current (as-is) behavior only; target behavior goes into open_decisions. Validated by validate_flow_spec.py against the feature inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "flow_id", "title", "actors", "related_features", "preconditions", "states", "events",
    "transitions", "invariants", "interruptions", "failure_handling", "cross_flow_interactions", "as_is_bugs",
    "open_decisions", "acceptance_tests", "excluded_identifiers"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "flow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Kebab-case; also the file name." },
    "title": { "type": "string", "minLength": 1 },
    "actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "e.g. user roles, server, media engine, system." },
    "related_features": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "description": "Inventory feature ids this flow covers. Their api_methods / ws_incoming / ws_outgoing must appear in the spec or in excluded_identifiers." },
    "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "base_flow": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Optional: flow_id of a spec this one extends (a variant of a shared flow). Shared steps are specified there, not repeated." },
    "scope_notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Optional: what this spec deliberately covers or leaves to other specs." },
    "entry_states": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "description": "Optional: states the flow can start in (several entry points). Default: the first state. Every state must be reachable from one of them." },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actor", "description", "ui", "resources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "snake_case. The first state is the initial state." },
          "actor": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "ui": { "type": "string", "description": "What the user sees." },
          "resources": { "type": "string", "description": "Media channel/role, realtime subscriptions, timers, capture sessions held in this state." }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "identifier", "payload"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "source": { "type": "string", "enum": ["user", "api_response", "ws", "sdk", "system", "timer"] },
          "identifier": { "type": "string", "minLength": 1, "description": "Exact API method / realtime message case / SDK callback / UI action." },
          "payload": { "type": "array", "items": { "type": "string" }, "description": "Fields that matter." }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "event", "guard", "actions", "to", "evidence"],
        "properties": {
          "from": { "type": "string", "minLength": 1, "description": "State id, or * for any state." },
          "event": { "type": "string", "minLength": 1, "description": "Event id." },
          "guard": { "type": ["string", "null"] },
          "actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Ordered side effects with exact identifiers: api:<method>, ws_out:<action>, sdk:<call>, ui:<...>, analytics:<...>, timer:<...>." },
          "to": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "pattern": "\\.[A-Za-z0-9]+:[0-9]+", "description": "path/File.swift:line" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[0-9]+$" },
          "statement": { "type": "string", "minLength": 1, "description": "A property that must always hold: resource cleanup, ordering, single-session rules." },
          "evidence": { "type": "string" }
        }
      }
    },
    "interruptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "situation", "current_behavior", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^INT-[0-9]+$" },
          "situation": { "type": "string", "minLength": 1, "description": "background, foreground, network loss, reconnect, incoming call, app kill, token expiry, another flow starts, ..." },
          "current_behavior": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "pattern": "\\.[A-Za-z0-9]+:[0-9]+" }
        }
      }
    },
    "failure_handling": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "situation", "current_behavior", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^FH-[0-9]+$" },
          "situation": { "type": "string", "minLength": 1 },
          "current_behavior": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "pattern": "\\.[A-Za-z0-9]+:[0-9]+" }
        }
      }
    },
    "cross_flow_interactions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "How this flow interacts with other flows (another session type starting, a call during a session, ...)." },
    "as_is_bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "evidence", "impact"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "pattern": "\\.[A-Za-z0-9]+:[0-9]+" },
          "impact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "current_behavior", "options"],
        "properties": {
          "id": { "type": "string", "pattern": "^OD-[0-9]+$" },
          "question": { "type": "string", "minLength": 1, "description": "Target behavior the product owner must decide. Never decided by the agent." },
          "current_behavior": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rule": { "type": ["string", "null"], "description": "Cross-cutting rule id this question is an instance of (see cross_cutting_decisions), or null." },
          "decision": { "type": ["string", "null"], "description": "Written back from DECISIONS.md once decided. 'defer to porting' is a valid decision." },
          "decided_on": { "type": ["string", "null"], "description": "ISO date of the decision." },
          "decision_ref": { "type": ["string", "null"], "description": "Where the decision is recorded, e.g. a DECISIONS.md topic or rule id. A decided question is never asked again." },
          "decision_evidence": { "type": ["string", "null"], "description": "Required when the decision aligns with a legacy/old app: path/File.swift:line evidence that the old source was actually read." }
        }
      }
    },
    "cross_cutting_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "decision"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][0-9]+$", "description": "Rule id shared across flows, e.g. A1." },
          "rule": { "type": "string", "minLength": 1 },
          "decision": { "type": ["string", "null"] }
        }
      },
      "description": "Rules decided once for every flow, copied here from DECISIONS.md so the spec is self-contained."
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "given", "when", "then", "covers"],
        "properties": {
          "id": { "type": "string", "pattern": "^AT-[0-9]+$" },
          "priority": { "type": "string", "enum": ["p0", "p1", "p2"] },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 },
          "covers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(happy_path|behavior|INV-[0-9]+|INT-[0-9]+|FH-[0-9]+)$" }, "description": "What this test covers: happy_path, an INV-/INT-/FH- id, or behavior for a plain behavior test. Every invariant, interruption and failure item must be covered, and at least one test covers happy_path." }
        }
      }
    },
    "excluded_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "reason"],
        "properties": {
          "identifier": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "description": "Identifiers of related features that are deliberately not part of this flow, each with a reason."
    }
  }
}
